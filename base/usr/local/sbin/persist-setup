#!/bin/sh
# persist-setup — set up the state that must survive an A/B slot switch:
# ssh host keys and the journal, both on /persist. machine-id deliberately
# does NOT persist; the things that would destabilise are pinned elsewhere
# (NIC MAC by 10-persistent-mac.link, DHCP lease by ClientIdentifier=mac).
set -eu

PERSIST=/persist
SSHDIR="$PERSIST/etc/ssh"
DROPIN=/etc/ssh/sshd_config.d/10-persist-hostkeys.conf

### ── U-Boot environment access ────────────────────────────────────────────
# Generated, not shipped: it must name the disk we actually booted from.
# Offsets MUST match board/uboot.config (ENV_OFFSET/_REDUND, ENV_SIZE).
ROOTSRC="$(findmnt -no SOURCE /)"
DISK="/dev/$(lsblk -no pkname "$ROOTSRC")"
printf '%s 0xD00000 0x20000\n%s 0xD80000 0x20000\n' "$DISK" "$DISK" > /etc/fw_env.config

### ── /persist must belong to the disk we booted from ──────────────────────
# PARTLABEL=persist exists on BOTH the rescue SD and the eMMC (flash-emmc
# keeps PARTLABELs), so with both media inserted the fstab mount can resolve
# to either. Repair before the host keys below are read.
WANT=""
for p in $(lsblk -lno NAME "$DISK" | tail -n +2); do
  [ "$(lsblk -no PARTLABEL "/dev/$p" 2>/dev/null)" = "persist" ] || continue
  WANT="/dev/$p"; break
done
if [ -n "$WANT" ]; then
  HAVE="$(findmnt -no SOURCE "$PERSIST" 2>/dev/null || true)"
  if [ -n "$HAVE" ] && [ "$HAVE" != "$WANT" ]; then
    echo "WARNING: $PERSIST was $HAVE, not on the boot disk $DISK; remounting $WANT" >&2
    journalctl --relinquish-var 2>/dev/null || true
    umount "$PERSIST" \
      || echo "WARNING: cannot unmount $HAVE — still using the wrong medium" >&2
  fi
  if ! mountpoint -q "$PERSIST"; then
    mkdir -p "$PERSIST"
    mount "$WANT" "$PERSIST" \
      || echo "WARNING: mounting $WANT on $PERSIST failed" >&2
  fi
fi

### ── SSH host keys ────────────────────────────────────────────────────────
# Fail safe: without /persist, fall back to per-slot keys rather than leave
# sshd with no host key at all.
if mountpoint -q "$PERSIST"; then
  mkdir -p "$SSHDIR"
  chmod 0755 "$PERSIST/etc" "$SSHDIR"
  # -f is a prefix; only missing keys are created.
  ssh-keygen -A -f "$PERSIST"
  mkdir -p /etc/ssh/sshd_config.d
  {
    echo "# generated by persist-setup; host keys live on the persist"
    echo "# partition so an A/B update does not change this box's identity."
    for t in ed25519 ecdsa rsa; do
      [ -f "$SSHDIR/ssh_host_${t}_key" ] && echo "HostKey $SSHDIR/ssh_host_${t}_key"
    done
  } > "$DROPIN"
else
  echo "WARNING: $PERSIST not mounted — using per-slot ssh host keys." >&2
  echo "         This box's ssh identity will change on the next update." >&2
  rm -f "$DROPIN"
  ssh-keygen -A
fi

### ── journal ──────────────────────────────────────────────────────────────
if mountpoint -q "$PERSIST"; then
  mkdir -p "$PERSIST/journal"
  # The early-boot flush ran while /var/log/journal still dangled (first
  # boot) or pointed at the wrong medium; flush again now the target exists.
  journalctl --flush 2>/dev/null || true
fi
