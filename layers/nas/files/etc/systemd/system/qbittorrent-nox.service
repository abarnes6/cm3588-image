[Unit]
Description=qBittorrent-nox confined to the WireGuard namespace
# BindsTo: qBittorrent must never run outside the tunnel.
Requires=qbt-netns.service
BindsTo=qbt-netns.service
After=qbt-netns.service
# /persist holds the profile; /srv/nfs/data holds the downloads.
RequiresMountsFor=/persist /srv/nfs/data

[Service]
Type=exec
User=qbt
Group=qbt
NetworkNamespacePath=/run/netns/qbt
# NetworkNamespacePath= does NOT perform `ip netns exec`'s /etc/netns/* bind
# mounts; without this the daemon reads the host resolv.conf, whose 127.0.0.53
# stub does not exist inside the namespace, and every lookup times out.
BindReadOnlyPaths=/etc/netns/qbt/resolv.conf:/etc/resolv.conf

WorkingDirectory=/persist/qbt-appdata
Environment=HOME=/persist/qbt-appdata
# "+" runs as root despite User=; the profile lives on /persist and cannot
# be created at build time.
ExecStartPre=+/usr/bin/install -d -o qbt -g qbt -m 0750 /persist/qbt-appdata
ExecStart=/usr/bin/qbittorrent-nox --webui-port=8080 --confirm-legal-notice --profile=/persist/qbt-appdata

LimitNOFILE=50000
# 0022: what qbt writes under /srv/nfs/data sits inside the NFS export, where
# AUTH_SYS gids are client-asserted — group-writable files would let any LAN
# client claiming gid 950 rewrite them.
UMask=0022
Restart=on-failure
RestartSec=5

# Sandboxing. Deliberately NOT set: SystemCallFilter and
# MemoryDenyWriteExecute — Qt has historically tripped both.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/persist/qbt-appdata /srv/nfs/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
