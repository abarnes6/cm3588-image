# CM3588-specific kernel quirks, appended to rk3588/kernel.config and
# asserted the same way.
# Built-in, not =m: the combo-PHY as a module leaves the RTL8125 on pcie2x1l2
# EPROBE_DEFERred until modules load.
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
# hwmon pwm1 + NVMe temperatures for userspace fan control (the DT declares a
# pwm-fan but no cooling-map, so the thermal core never drives it).
CONFIG_SENSORS_PWM_FAN=y
CONFIG_NVME_HWMON=y
