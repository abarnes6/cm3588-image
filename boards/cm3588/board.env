# boards/cm3588/board.env — FriendlyElec CM3588 Plus NAS (RK3588).
# Sourced by build-inner.sh after pins.env; ${VAR:=default} means the
# environment still wins for one-off overrides.
: "${UBOOT_DEFCONFIG:=cm3588-nas-rk3588_defconfig}"
: "${UBOOT_DTSI:=rk3588-friendlyelec-cm3588-nas-u-boot.dtsi}"
: "${DTB_PATH:=rockchip/rk3588-friendlyelec-cm3588-nas.dtb}"
