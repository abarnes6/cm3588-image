# pins.env — every moving input to the image. Sourced by build-inner.sh;
# ${VAR:=default} means the environment wins: KERNEL_TAG=v7.2 ./build.sh
# overrides for one run.

### ── source revisions ─────────────────────────────────────────────────────
: "${KERNEL_TAG:=v7.2-rc5}"      # -> v7.2 / v7.2.y when tagged
: "${UBOOT_TAG:=v2026.07}"       # boot-validated; bump deliberately
: "${ATF_TAG:=v2.15.0}"          # do NOT track master; BL31 decides EL3

### ── binary blobs from rkbin ──────────────────────────────────────────────
# Pinned by CONTENT: rkbin has no tags and rewrites history (the v1.18 DDR
# blob was deleted from the tree — recovery recipe in this repo's git history).
: "${DDR_BLOB:=rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v1.21.bin}"
: "${DDR_BLOB_SHA256:=ae96f7ddbc6ffa891ab24708e71930cb2968cfa7a2a0972fdc0cacd6891e4f95}"
# Empty DDR_BLOB_SHA256 skips the check; record the new hash once
# boot-validated.

# Mainline U-Boot/kernel needs mainline TF-A BL31 (the rkbin BL31 does not
# boot this board). Set empty for vendor-chain experiments.
: "${MAINLINE_ATF=1}"

### ── image identity ───────────────────────────────────────────────────────
# BOARD selects boards/$BOARD/board.env (U-Boot defconfig/dtsi, DTB) and
# boards/$BOARD/kernel.config, and prefixes image and kernel names.
: "${BOARD:=cm3588}"
: "${SUITE:=trixie}"
: "${MIRROR:=http://deb.debian.org/debian}"
: "${HOSTNAME_TGT:=$BOARD}"

### ── A/B slot layout ──────────────────────────────────────────────────────
# Slot PARTITIONS are fixed at flash time — size them for the life of the
# board. The FILESYSTEM inside a slot is smaller: every update writes and
# verifies exactly ROOTFS_SIZE_MB, and resize2fs can grow it in place later.
: "${SLOT_SIZE_MB:=8192}"
: "${ROOTFS_SIZE_MB:=2048}"
: "${PERSIST_SIZE_MB:=256}"      # grown to fill the disk on first boot

### ── console credentials ──────────────────────────────────────────────────
# Serial console only; root over ssh stays key-only. Prefer the hash
# (openssl passwd -6) so a real password never lands in git.
: "${ROOT_PASSWORD_HASH:=}"
: "${ROOT_PASSWORD:=changeme-on-first-login}"
