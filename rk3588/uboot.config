# U-Boot Kconfig fragment for A/B slot booting. Merged onto
# cm3588-nas-rk3588_defconfig; every line is asserted to survive the merge.

# Persistent, redundant environment for the A/B state (BOOT_ORDER,
# BOOT_x_LEFT). Offsets sit between the loader (~9.21 MiB) and the first
# partition at 16 MiB — the Rockchip default 0x3f8000 lands inside
# u-boot-rockchip.bin's padding and would be zeroed by loader updates.
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_SIZE=0x20000
CONFIG_ENV_OFFSET=0xD00000
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_OFFSET_REDUND=0xD80000

# Upstream's RAUC A/B bootmeth. PARTITIONS is "<boot>,<root>" per slot; both
# point at the same partition because each slot is one self-contained rootfs.
CONFIG_BOOTMETH_RAUC=y
CONFIG_BOOTMETH_RAUC_PARTITIONS="1,1 2,2"
CONFIG_BOOTMETH_RAUC_BOOT_ORDER="A B"
CONFIG_BOOTMETH_RAUC_DEFAULT_TRIES=3
CONFIG_BOOTMETH_RAUC_RESET_ALL_ZERO_TRIES=y

# If no bootflow boots (the selected slot is unreadable), reset instead of
# parking at the CLI: the try counter was already decremented and saved, so
# each pass burns one attempt and the boot order converges on the other slot
# unattended. Interrupt autoboot on serial for a prompt.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="bootflow scan -lb; reset"

# DW watchdog, armed from U-Boot on and left running into Linux, where dw_wdt
# takes it over and systemd pets it (watchdog.conf). Covers real hangs
# anywhere in the chain — but not the CLI, which pets it; that is why
# BOOTCOMMAND must reset explicitly.
CONFIG_WDT=y
CONFIG_DESIGNWARE_WATCHDOG=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=60000
