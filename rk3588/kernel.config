# Kernel fragment merged onto the arm64 defconfig; every line is asserted to
# survive the merge (assert_config in build-inner.sh). Applies to any RK3588
# board; per-board quirks live in boards/<board>/kernel.config, and
# CONFIG_LOCALVERSION is generated from $BOARD by build-inner.sh.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_ROCKCHIP_THERMAL=y
# Unattended recovery: dw_wdt built in, so the watchdog U-Boot armed is taken
# over before any module loads; systemd pets it from there (watchdog.conf).
# A panic reboots into the watchdog-armed loader instead of hanging, so a bad
# slot drains its boot attempts.
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_PANIC_TIMEOUT=10
